<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4EE0FF</item>
        <item name="android:colorControlActivated">#AE5BFF</item>
        <item name="android:colorControlHighlight">#444EE0FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#040614</item>
        <item name="android:navigationBarColor">#040614</item>
        <item name="android:navigationBarDividerColor">#3045DFFF</item>
        <item name="android:windowBackground">#040614</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:alertDialogTheme">@style/NeonAlertDialogTheme</item>
        <item name="android:dialogTheme">@style/NeonDialogTheme</item>
    </style>

    <style name="NeonAlertDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">#F4F8FF</item>
        <item name="android:textColorSecondary">#A3B3D9</item>
        <item name="android:colorAccent">#4EE0FF</item>
        <item name="android:colorControlActivated">#AE5BFF</item>
        <item name="android:backgroundDimAmount">0.76</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="NeonDialogTheme" parent="android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">#F4F8FF</item>
        <item name="android:textColorSecondary">#A3B3D9</item>
        <item name="android:colorAccent">#4EE0FF</item>
        <item name="android:backgroundDimAmount">0.76</item>
    </style>
</resources>
