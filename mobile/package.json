{
  "name": "minebot-ai-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MineBot AI local Android shell and offline-first management UI",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
